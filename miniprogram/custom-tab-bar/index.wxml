<!-- token-scope：组件在 page 节点之外，继承不到 page 上的自定义属性，自己挂一层。 -->
<view class="tab-bar token-scope">
  <view
    class="tab {{active === index ? 'tab--active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="pagePath"
    data-index="{{index}}"
    bindtap="onTap"
  >
    <wf-icon
      name="{{item.icon}}"
      role="{{active === index ? 'primary' : 'on-surface-variant'}}"
      size="44rpx"
    />
    <text class="tab__text">{{item.text}}</text>
  </view>
</view>
