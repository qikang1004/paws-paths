/* tokens.wxss 是生成物，semantic.wxss 是手写语义层，顺序不可颠倒。 */
@import './styles/tokens.wxss';
@import './styles/semantic.wxss';

/**
 * Skyline 不提供全局滚动（官方最佳实践原话：「Skyline no longer provides global
 * scrolling, using scroll-view for areas where scrolling is required」），页面根节点
 * 不是滚动容器。所以每个页面用一个铺满的 scroll-view 承载内容（`.page-scroll`），
 * 而 page 自己要给出确定高度 + 纵向 flex —— 少了这两行，flex:1 的滚动容器
 * 算不出剩余空间，页面照样滑不动。
 */
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background-color: var(--color-background);
  color: var(--color-on-surface);
  font-size: var(--font-body-md-size);
  line-height: var(--font-body-md-line);
}
