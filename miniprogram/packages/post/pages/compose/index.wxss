.compose {
  padding-top: var(--space-md);
}

.compose__section {
  margin-bottom: var(--space-lg);
}

.compose__label {
  display: block;
  margin-bottom: var(--space-xs);
}

.compose__pets {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

/* `.field` 的圆角是 --radius-full，多行文本会被那道弧切掉，这里压回中等圆角。 */
.compose__textarea {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
}

.compose__count {
  display: block;
  margin-top: var(--space-xs);
  text-align: right;
}

.compose__actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding-top: var(--space-md);
}

.compose__hint {
  text-align: center;
}
