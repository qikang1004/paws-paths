# 注意：代码里没有 dotenv 也没有 @nestjs/config，这个文件不会被自动读取。
# 它只是变量清单，实际启动必须由命令或部署平台注入环境变量。例如：
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paws SEED_DEMO_DATA=1 \
#     JWT_SECRET=dev-only-secret node dist/main.js

PORT=3000

# 微信小程序凭据。正式 AppID 与 AppSecret 不得写入仓库任何文件。
# 留空时 /auth/wx-login 报「缺少环境变量 WX_APPID」；填假值也不行——
# code2Session 会真的请求微信服务器，假 AppID 换回 errcode 40013。
# 本地联调用下面的 FAKE_WECHAT_LOGIN，不要为了绕过它去编 AppID。
WX_APPID=
WX_SECRET=

# 本地联调开关：跳过真微信登录，由 code 哈希出一个稳定的 fake- 前缀 openid。
# 只认字面 '1'。开着它等于任何 code 都能登录成任意用户，
# 部署环境必须留空或设 0。启动时会打一条 WARN 提醒。
FAKE_WECHAT_LOGIN=0

# 本地联调开关：跳过微信内容安全检查（msgSecCheck / imgSecCheck）。只认字面 '1'。
# 注意它**不放行**：所有 UGC 一律停在 pending（未过审内容对他人不可见），
# 所以开着它本地看不到自己发的动态，这是有意的 —— 假实现若直接放行，
# 「未 approved 对他人不可见」的安全测试就被测空了。
# 提审前必须关掉，并用正式 AppID 真跑一次两个接口。启动时会打一条 WARN。
FAKE_CONTENT_SECURITY=0

# 缺失时 signToken 与 AuthGuard 直接抛错，登录不可用。
JWT_SECRET=
JWT_TTL_SECONDS=604800

# 限流依赖 Redis。当前 RedisRateLimitStore 无降级：Redis 不可达或密码不对时
# 登录端点返回 500（见 docs/superpowers/phase0-carryforward.md）。
# 带密码时冒号前留空（无用户名）：redis://:密码@127.0.0.1:6379
# 密码含 @ : / ? # 需 percent-encoding。docker-compose.yml 里已设 requirepass，两边必须一致。
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379

# 不设则以 InMemory 模式运行（演示数据内置）。设了会在启动时自动建表。
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paws

# 仅当值为字面 '1' 时灌入演示数据（8 用户 / 8 宠物 / 17 照片 / 10 场所）。
# 'true' / 'yes' 不算开启，避免误灌生产库。
SEED_DEMO_DATA=0

# 不设则走纯 venue_extras 模式；设了才启用腾讯地图 POI 检索 + geohash 缓存。
TENCENT_MAP_KEY=

# 上传图片的落盘根目录，不设则用启动目录下的 var/uploads（已 gitignore）。
# 目录下分 public/ 与 private/ 两档：机审通过的进 public（任何人可取），
# 还没有结论的进 private（只有作者本人取得到，别人拿到 URL 也是 404）。
# 单机限定 —— 多副本部署时各实例只看得见自己那份盘，正式环境要换对象存储（spec §10）。
UPLOAD_ROOT=

LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_RATE_MAX_ATTEMPTS=30

# 运营后台（独立 Web，与 API 不同源）的跨域白名单，逗号分隔。
# **不设就是完全关闭跨域** —— 小程序不需要 CORS（wx.request 不受同源策略约束，
# 从来不发 Origin 头），所以没有这一项就说明还没有 Web 后台，那时一个来源都不该放。
#
# 每一项必须是 `协议://主机[:端口]`：不带路径、不带尾斜杠（浏览器发的 Origin
# 就是这个形状，比对是精确字符串匹配）。不接受 `*`（运营令牌能撤下任何内容，
# 而「临时设成 * 调通了就忘了改」是最常见的上线事故）。
# 只允许 https，localhost / 127.0.0.1 例外（本地起 dev server 时没有证书）。
# 配错任何一项启动直接失败 —— 跨域配错的表现是浏览器里一条离原因很远的报错。
ADMIN_ORIGINS=
