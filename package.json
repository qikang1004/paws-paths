{
  "name": "paws-paths",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "miniprogram",
    "admin"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "sync:types": "npm run build -w @paws/types && npm run sync:types -w miniprogram"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "jest": "29.7.0",
    "ts-jest": "29.1.2",
    "@types/jest": "29.5.12",
    "@types/node": "20.12.7"
  }
}
